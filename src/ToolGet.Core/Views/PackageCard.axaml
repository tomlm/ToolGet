<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ToolGet.Core.ViewModels;assembly=ToolGet.Core"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:console="https://github.com/jinek/consolonia"
             xmlns:local="using:ToolGet.Core"
             x:Class="ToolGet.Core.Views.PackageCard"
             x:DataType="vm:PackageCardViewModel"
             Width="{console:OnPlatform Default='350', Console='45'}">

  <!-- Design.DataContext removed to avoid requiring parameterless ctor in viewmodel during build -->

  <Border Background="{DynamicResource CardBackgroundBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}"
          BorderThickness="{console:OnPlatform Default=1, Console=1}"
          CornerRadius="{console:OnPlatform Default='8', Console='0'}"
          Padding="{console:OnPlatform Default='16', Console='0'}">


    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

      <!-- Package Title and Icon -->
      <Grid Grid.Row="0"
            Margin="{console:OnPlatform Default='0,0,0,8',Console='0,0,0,1'}"
            ColumnDefinitions="Auto * Auto"
            RowDefinitions="Auto Auto" >

        <!-- Icon bound to IconUrl -->
        <Image asyncImageLoader:ImageLoader.Source="{Binding IconUrl}"
               Grid.Column="0" Grid.RowSpan="2"
               Margin="{console:OnPlatform Default='0 0 8 0', Console='0 0 1 0'}"
               MaxWidth="{console:OnPlatform Default='48', Console='10'}"
               MaxHeight="{console:OnPlatform Default='48', Console='6'}"
               Stretch="UniformToFill"/>

        <TextBlock Margin="{console:OnPlatform Default='4', Console=1}"
                   Text="{Binding Title}"
                   Grid.Column="1"
                   FontWeight="Bold"
                   FontSize="{console:OnPlatform 16,Console=1}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>

        <Border Background="{DynamicResource PreReleaseBadgeBackgroundBrush}"
                Grid.Column="2"
                Padding="{console:OnPlatform Default='4,2', Console='1,1'}"
                CornerRadius="{console:OnPlatform Default='3', Console='0'}"
                Margin="{console:OnPlatform Default='8,0,0,0', Console='1,0,0,0'}"
                IsVisible="{Binding IsPrerelease}">
          <TextBlock Text="Pre" FontSize="{console:OnPlatform 10,Console=1}" Foreground="{DynamicResource PreReleaseBadgeForegroundBrush}" FontWeight="Bold"/>
        </Border>
        <!-- Authors and Downloads -->
        <StackPanel Grid.Row="1" Grid.Column="1"  >
          <StackPanel Orientation="Horizontal" >
            <TextBlock Text="👤" FontSize="{console:OnPlatform Default=12,Console=1}" />
            <TextBlock Text="{Binding Authors}"
                       FontSize="{console:OnPlatform 11,Console=1}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DownloadsString}"
                       FontSize="{console:OnPlatform 11,Console=1}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text=" downloads" FontSize="{console:OnPlatform '11',Console=1}" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>

      </Grid>

      <!-- Package ID and Version -->
      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  Margin="{console:OnPlatform Default='0,0,0,8', Console='0,0,0,1'}" >
        <TextBlock Text="{Binding Id}"
                   FontSize="{console:OnPlatform 12,Console=1}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text=" v" FontSize="{console:OnPlatform 12,Console=1}" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock Text="{Binding Version}"
                   FontSize="{console:OnPlatform 12,Console=1}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontWeight="Bold"/>
      </StackPanel>

      <!-- Description -->
      <TextBlock Grid.Row="2"
                 Text="{Binding Description}"
                 FontSize="{console:OnPlatform 13,Console=1}"
                 TextWrapping="Wrap"
                 TextTrimming="WordEllipsis"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 MaxLines="3" />


      <!-- Installing -->
      <local:AnimatedTextBlock Grid.Row="4"
                               IsVisible="{Binding IsInstalling}"
                               IsAnimating="{Binding IsInstalling}"
                               AnimationType="Wave"
                               FontSize="{console:OnPlatform Default='14', Console='1'}"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" />

      <!--buttons -->
      <Panel Grid.Row="4" IsVisible="{Binding !IsInstalling}">
        <Grid IsVisible="{Binding !IsInstalled}">
          <Button Grid.ColumnSpan="3"
                  Content="Install"
                  Command="{Binding InstallCommand}"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource OnAccentForegroundBrush}"
                  FontWeight="Bold">
          </Button>
        </Grid>

        <Grid IsVisible="{Binding IsInstalled}"
              ColumnDefinitions="{console:OnPlatform Default='* 10 *', Console='* 1 *'}">
          <!-- Update Button -->
          <Button Grid.Column="0"
                  Content="Update"
                  Command="{Binding UpdateCommand}"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource OnAccentForegroundBrush}"
                  FontWeight="Bold"/>
          <!-- Uninstall Button -->
          <Button Grid.Column="2"
                  Content="Uninstall"
                  Command="{Binding UnInstallCommand}"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource OnAccentForegroundBrush}"
                  FontWeight="Bold"/>
        </Grid>
      </Panel>
    </Grid>
  </Border>
</UserControl>