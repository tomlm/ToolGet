<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:console="https://github.com/jinek/consolonia"
        xmlns:vm="clr-namespace:ToolGet.Core.ViewModels;assembly=ToolGet.Core"
        xmlns:views="clr-namespace:ToolGet.Core.Views"
        x:Class="ToolGet.Core.Views.Search"
        x:DataType="vm:SearchViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="20">
            <StackPanel>
                <TextBlock Text="ToolGet" FontSize="{console:OnPlatform '24',Console='1'}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Search and install NuGet packages" FontSize="{console:OnPlatform '14',Console='1'}" Foreground="White" HorizontalAlignment="Center" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <!-- Search Controls -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Text="{Binding SearchQuery}"
                         Watermark="Enter package name or keywords..."
                         FontSize="{console:OnPlatform '16',Console='1'}"
                         Padding="12"
                         Margin="0,0,10,0"/>

                <Button Grid.Column="1"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding !IsSearching}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="20,12"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="2"
                        Content="Clear"
                        Command="{Binding ClearSearchCommand}"
                        Background="Transparent"
                        BorderBrush="#CCCCCC"
                        Padding="15,12"/>
            </Grid>
        </Border>

        <!-- Search Results -->
        <ScrollViewer Grid.Row="2" Padding="20">
            <StackPanel>
                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="{console:OnPlatform '14',Console='1'}"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding !IsSearching}"/>

                <!-- Loading Indicator -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsSearching}"
                           Margin="0,0,0,20">
                    <TextBlock Text="🔄" FontSize="{console:OnPlatform 16,Console=1}" Margin="0,0,10,0"/>
                    <TextBlock Text="Searching packages..." FontSize="{console:OnPlatform '14',Console='1'}"/>
                </StackPanel>

                <!-- Package Results -->
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:PackageCard Margin="0,0,20,20"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#EEEEEE" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding SearchResults.Count, StringFormat='Packages: {0}'}" 
                       FontSize="{console:OnPlatform '12',Console=1}" 
                       Foreground="#666666"/>
        </Border>
    </Grid>
</UserControl>