<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:console="https://github.com/jinek/consolonia"
             xmlns:vm="clr-namespace:ToolGet.Core.ViewModels;assembly=ToolGet.Core"
             xmlns:views="clr-namespace:ToolGet.Core.Views"
             xmlns:ice="clr-namespace:Iciclecreek.Avalonia.Controls;assembly=Iciclecreek.Avalonia.Controls"
             xmlns:local="using:ToolGet.Core"
             x:Class="ToolGet.Core.Views.Search"
             x:DataType="vm:SearchViewModel">

  <Grid RowDefinitions="Auto Auto * Auto">

    <!-- Search Header -->
    <Grid Background="{DynamicResource PrimaryBrush}" RowDefinitions="Auto Auto">
      <TextBlock Text="ToolGet"
                 FontSize="{console:OnPlatform 24,Console=1}"
                 FontWeight="Bold"
                 Foreground="White"
                 TextDecorations="Underline"
                 HorizontalAlignment="Center"/>
      <TextBlock Grid.Row="1"
                Text="Search and install dotnet tools"
                 FontSize="{console:OnPlatform 14,Console=1}"
                 Foreground="White"
                 HorizontalAlignment="Center" />
    </Grid>

    <!-- Search Controls -->
    <Grid Grid.Row="1"
           ColumnDefinitions="* Auto Auto Auto"
           RowDefinitions="Auto">
      <TextBox Grid.Column="0"
               Text="{Binding SearchQuery}"
               Watermark="Enter package name or keywords..."
               FontSize="{console:OnPlatform 16,Console=1}"
               Padding="{console:OnPlatform 12, Console=0}"
               Margin="{console:OnPlatform '0,0,10,0', Console='0 0 1 0'}"
               KeyDown="SearchBox_KeyDown"/>

      <Button Grid.Column="1"
              Content="_Search"
              Command="{Binding SearchCommand}"
              IsEnabled="{Binding !IsSearching}"
              Background="{DynamicResource AccentBrush}"
              Foreground="White"
              FontWeight="Bold"
              Margin="{console:OnPlatform Default='8 0 8 0', Console='0 0 1 0'}"
              Padding="{console:OnPlatform Default='20,12', Console='1 0 1 0'}"/>

      <Button Grid.Column="2"
              Content="_Installed"
              Command="{Binding ShowInstalledCommand}"
              IsEnabled="{Binding !IsSearching}"
              Background="{DynamicResource AccentBrush}"
              Foreground="White"
              FontWeight="Bold"
              Margin="{console:OnPlatform Default='8 0 8 0', Console='0 0 1 0'}"
              Padding="{console:OnPlatform Default='20,12', Console='1 0 1 0'}"/>

      <Button Grid.Column="3"
              Content="E_xit"
              Command="{Binding ExitCommand}"
              Background="{DynamicResource AccentBrush}"
              Foreground="White"
              FontWeight="Bold"
              Margin="{console:OnPlatform Default='8 0 8 0', Console='0 0 1 0'}"
              Padding="{console:OnPlatform Default='20,12', Console='1 0 1 0'}"/>
    </Grid>

    <!-- Search Results -->
    <ScrollViewer Grid.Row="2">
      <StackPanel>

        <!-- Loading Indicator -->

        <StackPanel Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsSearching}"
                   Margin="{console:OnPlatform Default='0,0,0,20', Console='0'}">

          <TextBlock Text="Searching " 
                     Foreground="Black"
                     FontSize="{console:OnPlatform Default=14,Console=1}"/>
          <ice:TextBlockSpinner
             IsActive="{Binding IsSearching}"
             Foreground="Black"
             AnimationType="Wave"
             VerticalAlignment="Center"
             Margin="0 0 1 0"
             FontSize="{console:OnPlatform 16, Console=1}" />
        </StackPanel>


        <!-- Package Results -->
        <ItemsControl ItemsSource="{Binding SearchResults}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <views:PackageCard Margin="{console:OnPlatform Default='0,0,20,20', Console=1}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Status Bar -->
    <Grid Grid.Row="3"
          ColumnDefinitions="* Auto"
          Background="#EEEEEE">
      <!-- Status Message -->
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="{console:OnPlatform Default=14,Console=1}"
                 Margin="{console:OnPlatform Default='0,0,0,20', Console='0'}"
                 HorizontalAlignment="Center"
                 IsVisible="{Binding !IsSearching}"/>
      <TextBlock Grid.Column="1"
                 Text="{Binding SearchResults.Count, StringFormat='Packages: {0}'}"
                 FontSize="{console:OnPlatform Default='12',Console=1}"
                 Padding="{console:OnPlatform Default='8,0,8,0', Console='0,0,1,0'}"
                 Foreground="#666666"/>

    </Grid>
  </Grid>
</UserControl>