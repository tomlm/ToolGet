<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ToolGet.Core.ViewModels;assembly=ToolGet.Core"
             x:Class="ToolGet.Console.Views.PackageCard"
             x:DataType="vm:PackageCardViewModel">

    <Design.DataContext>
        <vm:PackageCardViewModel/>
    </Design.DataContext>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            Padding="2"
            Margin="0,1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Package Title and Version -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Icon -->
                <Image Source="{Binding IconUrl}"
                       Width="32" Height="32"
                       Margin="0,0,6,0"
                       Stretch="UniformToFill"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" 
                           FontWeight="Bold" 
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text=" (Pre)" 
                           FontWeight="Bold"
                           IsVisible="{Binding IsPrerelease}"/>
            </StackPanel>

            <!-- Install Button -->
            <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="4"
                    Content="{Binding InstallButtonText}"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding !IsInstalling}"
                    MinWidth="10"
                    VerticalAlignment="Stretch"/>

            <!-- Package ID and Version -->
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{Binding Id}" 
                           FontSize="10" 
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text=" v" FontSize="10"/>
                <TextBlock Text="{Binding Version}" 
                           FontSize="10" 
                           FontWeight="Bold"/>
            </StackPanel>

            <!-- Description -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{Binding Description}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       TextTrimming="WordEllipsis"
                       MaxLines="2"/>

            <!-- Authors and Downloads -->
            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{Binding Authors}" 
                           FontSize="9" 
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text=" | " FontSize="9"/>
                <TextBlock Text="{Binding DownloadsString}" 
                           FontSize="9"/>
                <TextBlock Text=" DL" FontSize="9"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>