<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ToolGet.Core.ViewModels;assembly=ToolGet.Core"
        xmlns:views="clr-namespace:ToolGet.Console.Views"
        x:Class="ToolGet.Console.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ToolGet - NuGet Package Search (Console)"
        Width="120"
        Height="40">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="2">
            <StackPanel>
                <TextBlock Text="ToolGet - NuGet Package Search" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Search and install NuGet packages via console" HorizontalAlignment="Center" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- Search Controls -->
        <Border Grid.Row="1" Padding="1" Margin="0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Text="{Binding SearchQuery}"
                         Watermark="Enter package name..."
                         Margin="0,0,1,0"/>

                <Button Grid.Column="1"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding !IsSearching}"
                        Margin="0,0,1,0"/>

                <Button Grid.Column="2"
                        Content="Clear"
                        Command="{Binding ClearSearchCommand}"/>
            </Grid>
        </Border>

        <!-- Search Results -->
        <ScrollViewer Grid.Row="2" Padding="1">
            <StackPanel>
                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding !IsSearching}"
                           Margin="0,1"/>

                <!-- Loading Indicator -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsSearching}"
                           Margin="0,1">
                    <TextBlock Text="Searching..." FontWeight="Bold"/>
                </StackPanel>

                <!-- Package Results -->
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:PackageCard Margin="0,0,0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#EEEEEE" Padding="1">
            <TextBlock Text="{Binding SearchResults.Count, StringFormat='Packages: {0}'}" 
                       FontSize="10"/>
        </Border>
    </Grid>
</Window>